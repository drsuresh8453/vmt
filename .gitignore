# .gitignore — Vehicle Mileage MLOps Project

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# Virtual Environment
venv/
env/
.venv/
.env/

# Environment files
.env
*.env

# Models (trained locally — stored in S3)
models/*.pkl
models/*.h5
models/*.joblib

# Data files (stored in S3)
data/reference/*.csv
data/current/*.csv
data/demo_drift/*.csv

# Reports
reports/*.html
reports/*.json

# Jupyter Notebooks (not production code)
*.ipynb
.ipynb_checkpoints/

# MLflow
mlruns/
mlflow.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Coverage
.coverage
htmlcov/
.pytest_cache/

# Temp files
/tmp/
*.tmp
